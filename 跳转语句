跳转语句
1.break跳转
#include<iostream>
using namespace std;

int main() {
	//break的使用时机
	//1.出现在switch语句中
	//2.出现在循环语句中

	cout << "请选择副本难度" << endl;
	cout << "1."<<endl;
	cout << "2." << endl;
	cout << "3." << endl;
	
	int select = 0;
	cin >> select;
	switch (select) {
	case 1:
		cout << "您选择的是普通难度" << endl;
		break;
	case 2:
		cout << "您选择的是中等难度" << endl;
		break;
	case 3:
		cout << "您选择的是困难难度" << endl;
		break;
	default :
		break;
	}
	system("pause");
	return 0;

}




2.continue语句
e.g.在循环中使用continue语句，就是执行到这里后就不执行了，然后重新进入循环。
与break的区别：break是直接全部都不执行了。

用一个仅输出奇数的例子来举例：

#include<iostream>
using namespace std;
int main() {
	//continue执行到本行后，就不会再执行下一行代码了，而是重新执行一次循环
	for (int i = 0;i <= 100; i++) {
		
		if (i % 2 == 0) {
			continue;//可以筛选条件，执行到此就不再循环，重新开始下一轮循环
		}
		cout << i << endl;
	}
}

其实可以用其他方法实现这串代码
	for (int i = 0;i <= 100; i++) {
		if (i % 2 == 1) {
			cout << i << endl;
		}



3.goto语句
作用：无条件跳转语句

#include<iostream>
using namespace std;
int main() {
	//goto语句，不太建议使用
	cout << "1." << endl;
	goto FLAG;   //注意这里后面是分号；
	cout << "2." << endl;
	cout << "3." << endl;
	cout << "4." << endl;
	FLAG:  //注意FLAG后面是冒号：
	cout << "5." << endl;
	system("pause");
	return 0;
}
